rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function ownsDocument() {
      return signedIn() && resource.data.ownerId == request.auth.uid;
    }

    function createsOwnedDocument() {
      return signedIn() && request.resource.data.ownerId == request.auth.uid;
    }

    function keepsOwnership() {
      return request.resource.data.ownerId == resource.data.ownerId;
    }

    match /students/{studentId} {
      allow create: if createsOwnedDocument();
      allow read, delete: if ownsDocument();
      allow update: if ownsDocument() && keepsOwnership();
    }

    match /homework/{homeworkId} {
      allow create: if createsOwnedDocument();
      allow read, delete: if ownsDocument();
      allow update: if ownsDocument() && keepsOwnership();
    }
  }
}
